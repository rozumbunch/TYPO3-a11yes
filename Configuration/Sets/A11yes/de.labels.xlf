        <target>Theme Hintergrund</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.theme.secondaryBackground">
        <source>Theme secondary background</source>
        <target>Theme Sekundär-Hintergrund</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.theme.sectionBorder">
        <source>Theme section border</source>
        <target>Theme Abschnitt-Rahmen</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.theme.switchBackground">
        <source>Theme switch background</source>
        <target>Theme Schalter-Hintergrund</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.otherFunctions.enabled">
        <source>Additional helper functions</source>
        <target>Weitere Hilfsfunktionen</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.otherFunctions.enabled">
        <source>Controls otherFunctions in A11yes.</source>
        <target>Schaltet otherFunctions in A11yes.</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.icons.enabled">
        <source>Use icons</source>
        <target>Icons verwenden</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.hideFixedButton">
        <source>Hide tools button bottom right</source>
        <target>Tools Button rechts unten ausblenden</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.renderSiteButtonPartial">
        <source>Render fixed frontend button automatically</source>
        <target>Fixierten Frontend-Button automatisch rendern</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.renderSiteButtonPartial">
        <source>Renders the SiteButtonA11yes partial automatically via page.footerData.</source>
        <target>Rendert das Partial SiteButtonA11yes automatisch via page.footerData.</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.linksJson">
        <source>Links (JSON array)</source>
        <target>Links (JSON-Array)</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.linksJson">
        <source>JSON array of entries [label, URL, target]. Target can be _blank or _self. Example: [["Accessibility statement","https://example.com/accessibility","_self"]]</source>
        <target>JSON-Array von Einträgen [Label, URL, Ziel]. Ziel kann _blank oder _self sein. Beispiel: [["Barrierefreiheitserklärung","https://example.de/barrierefreiheit","_self"]]</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.translationsPathPattern">
        <source>Translation JSON path pattern</source>
        <target>Pfad-Muster für Übersetzungs-JSON</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.translationsPathPattern">
        <source>Relative path with the placeholder {language} (ISO code such as de or en). This becomes the translations value in the frontend JSON.</source>
        <target>Relativer Pfad mit Platzhalter {language} (ISO-Code wie de oder en). Wird zu translations im Frontend-JSON.</target>
      </trans-unit>
