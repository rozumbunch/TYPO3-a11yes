        <source>Font families</source>
        <target>Schriftarten</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.fontsJson">
        <source>JSON object: display name as key, CSS font-family as value. Example: {"Open Sans":"Open Sans, sans-serif","Times New Roman":"Times New Roman, serif"}</source>
        <target>JSON-Objekt: Anzeigename als Schlüssel, CSS font-family als Wert. Beispiel: {"Open Sans":"Open Sans, sans-serif","Times New Roman":"Times New Roman, serif"}</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.contrast.enabled">
        <source>Show contrast mode</source>
        <target>Kontrastmodus anzeigen</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.contrast.highlightColor">
        <source>Highlight color</source>
        <target>Highlight-Farbe</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.contrast.highlightColor">
        <source>Color for highlights in contrast mode (highLightColor).</source>
        <target>Farbe für Hervorhebungen im Kontrastmodus (highLightColor).</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.theme.enabled">
        <source>Enable A11yes theme colors</source>
        <target>A11yes-Themefarben aktivieren</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.theme.foreground">
