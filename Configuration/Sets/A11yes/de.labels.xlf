        <source>Configuration source</source>
        <target>Konfigurationsquelle</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.inclusionMode">
        <source>Inclusion type</source>
        <target>Einbindungsart</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.inclusionMode">
        <source>Defines whether only the frontend library is loaded, or configuration is injected automatically without custom Fluid/TypoScript integration.</source>
        <target>Legt fest, ob nur die Frontend-Bibliothek geladen wird oder die Konfiguration automatisch ohne eigene Fluid/TypoScript-Integration injiziert wird.</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.inclusionMode.enum.libraryOnly">
        <source>Frontend library only - no custom configuration</source>
        <target>Nur Frontend Bibliothek - Ohne eigene Konfiguration</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.inclusionMode.enum.configurable">
        <source>Configurable integration</source>
        <target>Konfigurierbare Einbindung</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.mode">
        <source>Choose whether A11yes reads from Site Settings or TypoScript constants.</source>
        <target>Wähle, ob A11yes aus Site Settings oder aus TypoScript-Constants liest.</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.mode.enum.siteSettings">
        <source>Use Site Settings</source>
        <target>Site Settings verwenden</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.mode.enum.typoScript">
        <source>Use TypoScript constants</source>
        <target>TypoScript-Constants verwenden</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.fontSize.enabled">
        <source>Show font size controls</source>
        <target>Schriftgröße anzeigen</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.fontSize.enabled">
        <source>Shows or hides the font size controls in the A11yes dialog.</source>
        <target>Zeigt die Steuerung der Schriftgröße im A11yes-Dialog an oder blendet sie aus.</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.fontSize.step">
        <source>Font size: step (px)</source>
        <target>Schriftgröße: Schritt (px)</target>
      </trans-unit>
      <trans-unit id="settings.description.a11yes.fontSize.step">
        <source>Pixel step per click (A11yes fontSizeStep).</source>
        <target>Pixel-Schrittweite pro Klick (A11yes fontSizeStep).</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.fontSize.maxSteps">
        <source>Font size: maximum steps up</source>
        <target>Schriftgröße: max. Schritte nach oben</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.fontSize.minSteps">
        <source>Font size: maximum steps down</source>
        <target>Schriftgröße: max. Schritte nach unten</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.letterSpacing.enabled">
        <source>Show letter spacing controls</source>
        <target>Zeichenabstand anzeigen</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.letterSpacing.step">
        <source>Letter spacing: step (px)</source>
        <target>Zeichenabstand: Schritt (px)</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.letterSpacing.maxSteps">
        <source>Letter spacing: maximum steps</source>
        <target>Zeichenabstand: max. Schritte</target>
      </trans-unit>
      <trans-unit id="settings.a11yes.letterSpacing.minSteps">
        <source>Letter spacing: minimum steps</source>
        <target>Zeichenabstand: min. Schritte</target>
      </trans-unit>
